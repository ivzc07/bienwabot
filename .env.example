# rebe-agent environment.
#
# Every variable the process reads, and nothing else - `rebe_agent/config.py` is
# the single entry point, so this file and that module stay in step.
# In production these are Coolify per-app environment variables, encrypted at
# rest. Never commit real values; this file carries names and shapes only.
#
# Source of truth: docs/wayfinder/deployment-architecture-spec.md, section 4.

# --- Required. The process refuses to start if any of these is absent or blank.

# DeepSeek brain (non-thinking chat model).
DEEPSEEK_API_KEY=

# Internal URL of the bien-evo Evolution API. Container name, not a public host:
# the agent reaches Evolution over the shared Docker network and has no public URL.
EVOLUTION_API_URL=http://bien-evo-api:8080

# Evolution's AUTHENTICATION_API_KEY.
EVOLUTION_API_KEY=

# Token embedded in the webhook path (POST /webhook/<secret>). Defence in depth
# even on an internal network; must match the per-instance webhook Evolution posts to.
WEBHOOK_SECRET=

# psycopg URL to the `rebe` database on bien-evo's Postgres (group_memory, posted_store).
REBE_DATABASE_URL=postgresql://rebe:CHANGE_ME@bien-evo-pg:5432/rebe

# Out-of-band alert channel: ban / 463 / Evolution disconnect / DeepSeek errors.
# Telegram rather than WhatsApp, so alerts still arrive when Evolution is down.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Uptime Kuma push monitor. A missed ~60s heartbeat makes Kuma fire the Telegram alert.
KUMA_PUSH_URL=

# --- Optional. Defaults shown; set only to override.

# Active Evolution instance. Manual failover on a permanent ban is: set this to
# bien-backup and redeploy. Never run both instances posting at once.
EVOLUTION_INSTANCE=bien-rebe

# Drives quiet hours (02:00-06:00 near-silent) and the circadian posting shape.
TZ=America/Mexico_City

# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO
